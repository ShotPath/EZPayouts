{
  "manifest_version": 3,
  "name": "EZPayouts Chart Skins",
  "short_name": "EZ Skins",
  "version": "1.4.0",
  "description": "Liquid chrome, sakura, stars, Matrix rain, a black hole and more behind your TradingView charts, plus restyled order tags.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "EZPayouts Chart Skins",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_ui": {
    "page": "popup/popup.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://*.tradingview.com/*",
    "https://*.tradingview-widget.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/*",
        "https://*.tradingview-widget.com/*"
      ],
      "js": [
        "content/page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://*.tradingview.com/*",
        "https://*.tradingview-widget.com/*"
      ],
      "js": [
        "shared/skins.js",
        "content/skin-host.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "skin/skin.html",
        "popup/fonts/*.woff2"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "toggle-skin": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Turn the wallpaper on or off"
    }
  }
}
